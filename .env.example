# =============================================================================
# Pulumi state backend — S3 bucket (the service reads stack state from S3 directly)
# =============================================================================
PULUMI_BACKEND_URL=s3://my-pulumi-state-bucket
# Passphrase that encrypts secrets in stack state. Set once; do not change it for existing stacks.
PULUMI_CONFIG_PASSPHRASE=change-me-to-a-strong-passphrase

# Pulumi Cloud token — only used if PULUMI_BACKEND_URL is unset
# PULUMI_ACCESS_TOKEN=pul-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# AWS credentials — provision the AWS side and read/write the state bucket
# =============================================================================
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Azure service principal — provisions the Azure side of the VPN.
# Create with:
#   az ad sp create-for-rbac --name "multicloud-demo" --role Contributor \
#     --scopes /subscriptions/<SUBSCRIPTION_ID>
# =============================================================================
ARM_CLIENT_ID=your-service-principal-app-id
ARM_CLIENT_SECRET=your-service-principal-secret
ARM_TENANT_ID=your-azure-tenant-id
ARM_SUBSCRIPTION_ID=your-azure-subscription-id

# =============================================================================
# API authentication
# =============================================================================
# HS256 key used to validate bearer tokens on every route (generate a long random value)
jwt_secret_key=change-me-to-a-long-random-string

# =============================================================================
# Optional integrations
# =============================================================================
# Slack notifications
# SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>
